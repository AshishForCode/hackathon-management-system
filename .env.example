# =============================================================================
# Hackathon Management Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================================

# ---- Database ----
DATABASE_URL="postgresql://hackathon_user:hackathon_pass@localhost:5432/hackathon_db?schema=public"

# ---- NextAuth / Auth.js ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"  # Generate: openssl rand -base64 32

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ALLOWED_DOMAIN="jecrcu.edu.in"  # Restrict Google login to this domain (leave empty to allow all)

# ---- Email (Nodemailer) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@hackathon-platform.com"

# ---- GitHub Integration ----
GITHUB_API_TOKEN=""  # Personal access token for repo stats
GITHUB_WEBHOOK_SECRET=""  # Secret for verifying GitHub webhooks

# ---- App Configuration ----
APP_NAME="JECRC Hackathon Platform"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- File Storage ----
UPLOAD_DIR="./uploads"  # Local file storage path
MAX_FILE_SIZE_MB="10"   # Maximum upload size in MB

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"  # Max requests per window

# ---- Certificate Generation ----
# Puppeteer is used server-side; no external service required
CERTIFICATE_TEMPLATE_PATH="./public/templates/certificate.html"
